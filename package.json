{
  "name": "kanvas-studio",
  "version": "0.4.1",
  "description": "Free, open-source, local-first visual design engine for AI agents over MCP — Design Intelligence, Brand Kits, Visual QA, Smart Resize, Marketing Campaigns, Data Viz, Presentation/PPTX export, Design-to-Code, Asset Library, and Community Ecosystem.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ranggaoscar/kanvas-studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ranggaoscar/kanvas-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ranggaoscar/kanvas-studio/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ranggaoscar"
  },
  "bin": {
    "kanvas": "bin/kanvas.js"
  },
  "files": [
    "bin",
    "server",
    "app/index.html",
    "app/render.html",
    "app/dist",
    "docs",
    "desktop",
    "skills",
    "!**/__pycache__",
    "!**/*.pyc",
    "templates",
    "plugin.json",
    "mcp.json",
    "install.sh",
    "install.ps1"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node bin/kanvas.js",
    "mcp": "node bin/kanvas.js mcp",
    "doctor": "node bin/kanvas.js doctor",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "design",
    "canvas",
    "mcp",
    "ai-agent",
    "art-direction",
    "brand-kit",
    "pptx",
    "dataviz",
    "design-to-code",
    "claude-code",
    "codex",
    "hermes",
    "presentation",
    "poster",
    "logo"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lucide-static": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
